# Required: OpenAI API key for GPT-4 analysis
OPENAI_API_KEY=sk-your-key-here

# Optional: Server configuration (defaults shown)
ARE_HOST=127.0.0.1
ARE_PORT=8000

# Optional: Frontend API URL (only needed for separate dev servers)
# Leave empty when frontend is served by the backend
REACT_APP_API_BASE_URL=http://localhost:8000
